# Ignore everything by default
*

# Allow Jekyll site and essential root files
!postgen_web/
!postgen_web/**
!assets/
!assets/**
!.gitignore
!README.md
!LICENSE
!git_post_gen.sh
!.github/
!.github/**

# Always ignore local backend and dev artifacts
postgen_studio/
venv/
_localfiles/
_shscripts/
configs/
data/
logs/
outputs/
results/
scripts/
temp/
.vscode/
test_servers.sh

# macOS system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Inside the Jekyll site, ignore build artifacts and Ruby environment files
postgen_web/_site/
postgen_web/.sass-cache/
postgen_web/.jekyll-cache/
postgen_web/.bundle/
postgen_web/vendor/
postgen_web/Gemfile.lock
postgen_web/_config_dev.yml

# Node/npm artifacts (if ever used)
postgen_web/node_modules/